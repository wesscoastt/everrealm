{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "everrealm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5188
    },
    {
      "name": "everrealm-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787
    },
    {
      "name": "everrealm-survey",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191
    },
    {
      "name": "everrealm-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        ".pagesdist",
        "--base",
        "/everrealm/",
        "--port",
        "4190",
        "--strictPort"
      ],
      "port": 4190
    }
  ]
}
